{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "admin/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "user/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    { "src": "/(.*).html", "dest": "/$1.html" },
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/user/(.*)", "dest": "/user/$1" }
  ]
}
